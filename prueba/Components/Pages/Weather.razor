@page "/weather"
@attribute [StreamRendering]
@using prueba.Data
@using prueba.Services
@inject Microsoft.Extensions.Logging.ILogger<Weather> Logger

<PageTitle>Actividades Usuarios</PageTitle>

<h1>Actividades Usuarios</h1>

<p>Test de actividades</p>

@if (actividades == null)
{
    <p><em>Loading...</em></p>
}
else if (actividadesError != null)
{
    <div class="alert alert-danger" role="alert">
        <strong>Database error:</strong> @actividadesError
        <details>
            <summary>Show details</summary>
            <pre>@actividadesErrorDetail</pre>
        </details>
    </div>
}
else if (!actividades.Any())
{
    <p><em>No actividades found.</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Id Sala</th>
                <th>Id Ponencia</th>
                <th>Fecha</th>
                <th>Hora Inicio</th>
                <th>Hora Fin</th>
                <th>Tipo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in actividades)
            {
                <tr>
                    <td>@a.IdActividad</td>
                    <td>@(a.IdSala?.ToString() ?? "")</td>
                    <td>@(a.IdPonencia?.ToString() ?? "")</td>
                    <td>@a.Fecha.ToString("yyyy-MM-dd")</td>
                    <td>@a.HoraInicio.ToString()</td>
                    <td>@a.HoraFin.ToString()</td>
                    <td>@a.TipoActividad</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Inject]
    private IWeatherService WeatherService { get; set; } = null!;

    private Actividad[] actividades = Array.Empty<Actividad>();
    private string? actividadesError;
    private string? actividadesErrorDetail;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            actividades = await WeatherService.GetActividadesAsync();
        }
        catch (Exception ex)
        {
            actividadesError = ex.Message;
            actividadesErrorDetail = ex.ToString();
            actividades = Array.Empty<Actividad>();
            Logger.LogError(ex, "Error fetching actividades in component");
        }
    }
}

