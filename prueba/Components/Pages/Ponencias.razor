@page "/ponencias"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using prueba.Data
@using prueba.Services
@inject IPonenciasCrudService PonenciasSvc
@inject IPonentesCrudService PonentesSvc
@inject IPonenteActualService PonenteActualSvc
@inject IPdfStorageService Pdfs

<h3>Registrar ponencia</h3>

@if (_error != null)
{
    <div class="alert alert-danger">@_error</div>
}
@if (_mensaje != null)
{
    <div class="alert alert-success">
        @_mensaje <a href="/mis-ponencias">Consultar estado de mis ponencias</a>
    </div>
}

@if (_ponenteActual is null)
{
    <div class="card card-body mb-3">
        <label class="form-label">Ponente <small class="text-muted">(modo prueba: sin sesión de ponente)</small></label>
        <select class="form-select" @bind="_idSel" @bind:after="CargarPonencias">
            <option value="">-- Selecciona --</option>
            @foreach (var p in _ponentes)
            {
                <option value="@p.Ponente!.IdPonente">@p.Nombre @p.Apellido_paterno</option>
            }
        </select>
    </div>
}
else
{
    <p>Ponente: <strong>@_ponenteActual.Nombre @_ponenteActual.Apellido_paterno</strong></p>
}

<EditForm Model="_model" OnValidSubmit="Guardar" class="card card-body mb-4">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <h5>@(_editando ? "Editar ponencia" : "Nueva ponencia")</h5>

    <div class="mb-2">
        <label class="form-label">Título</label>
        <InputText class="form-control" @bind-Value="_model.Titulo" />
    </div>
    <div class="mb-2">
        <label class="form-label">Resumen</label>
        <InputTextArea class="form-control" rows="3" @bind-Value="_model.Resumen" />
    </div>
    <div class="mb-2">
        <label class="form-label">Categoría / área temática</label>
        <InputText class="form-control" @bind-Value="_model.Categoria" />
    </div>
    <div class="mb-3">
        <label class="form-label">Archivo PDF (máx. 10 MB)</label>
        <InputFile class="form-control" accept=".pdf,application/pdf" OnChange="SeleccionarPdf" />
        @if (_editando && !string.IsNullOrEmpty(_model.ArchivoPdfUrl))
        {
            <small>Actual: <a href="@_model.ArchivoPdfUrl" target="_blank">ver PDF</a> (sube otro para reemplazarlo)</small>
        }
    </div>

    <div>
        <button class="btn btn-primary" type="submit">@(_editando ? "Guardar cambios" : "Registrar ponencia")</button>
        <button class="btn btn-secondary" type="button" @onclick="Nuevo">Cancelar</button>
    </div>
</EditForm>

<h5>Mis ponencias registradas</h5>
<table class="table table-striped">
    <thead><tr><th>Título</th><th>Categoría</th><th>Estado</th><th>PDF</th><th></th></tr></thead>
    <tbody>
        @foreach (var p in _lista)
        {
            <tr>
                <td>@p.Titulo</td>
                <td>@p.Categoria</td>
                <td><span class="badge @EstadoPonencia.Badge(p.Estado)">@EstadoPonencia.Etiqueta(p.Estado)</span></td>
                <td>@if (!string.IsNullOrEmpty(p.ArchivoPdfUrl)) {
                    <a href="@p.ArchivoPdfUrl" target="_blank">Ver</a>
                }
            </td>
            <td>
                @if (p.Estado == EstadoPonencia.Recibida)
                {
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => Editar(p)">Editar</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(p)">Eliminar</button>
                }
                else
                {
                    <small class="text-muted">Bloqueada (ya revisada)</small>
                }
            </td>
        </tr>
    }
</tbody>
</table>

@code {
    List<Ponencia> _lista = new();
    List<Participante> _ponentes = new();
    Participante? _ponenteActual;
    string _idSel = "";
    Ponencia _model = new();
    IBrowserFile? _pdf;
    bool _editando;
    string? _error, _mensaje;

    string? IdPonenteActivo =>
        _ponenteActual?.Ponente?.IdPonente ?? (string.IsNullOrEmpty(_idSel) ? null : _idSel);

    protected override async Task OnInitializedAsync()
    {
        _ponenteActual = await PonenteActualSvc.GetAsync();
        _ponentes = await PonentesSvc.GetAllAsync();
        await CargarPonencias();
    }

    async Task CargarPonencias() =>
        _lista = IdPonenteActivo is null ? new() : await PonenciasSvc.GetByPonenteAsync(IdPonenteActivo);

    void Nuevo() { _model = new(); _pdf = null; _editando = false; _error = null; }

    void Editar(Ponencia p)
    {
        _editando = true; _pdf = null; _error = null; _mensaje = null;
        _model = new Ponencia
        {
            Id = p.Id,
            IdPonente = p.IdPonente,
            Titulo = p.Titulo,
            Resumen = p.Resumen,
            Categoria = p.Categoria,
            ArchivoPdfUrl = p.ArchivoPdfUrl,
            Estado = p.Estado
        };
    }

    void SeleccionarPdf(InputFileChangeEventArgs e) => _pdf = e.File;

    async Task Guardar()
    {
        _error = null; _mensaje = null;
        string? anterior = null, nuevoPdf = null;
        try
        {
            if (IdPonenteActivo is null) { _error = "Selecciona un ponente."; return; }
            if (!_editando && _pdf is null) { _error = "Adjunta el archivo PDF de la ponencia."; return; }

            _model.IdPonente = IdPonenteActivo;

            if (_pdf != null)
            {
                anterior = _model.ArchivoPdfUrl;
                nuevoPdf = await Pdfs.SaveAsync(_pdf);
                _model.ArchivoPdfUrl = nuevoPdf;
            }

            if (_editando) await PonenciasSvc.ActualizarDatosAsync(_model);
            else await PonenciasSvc.RegistrarAsync(_model);

            Pdfs.Delete(anterior);
            _mensaje = _editando
                ? "Cambios guardados."
                : "Ponencia registrada con estado «Recibida». Quedó pendiente de revisión del administrador.";
            Nuevo();
            await CargarPonencias();
        }
        catch (Exception ex)
        {
            if (nuevoPdf != null) { Pdfs.Delete(nuevoPdf); _model.ArchivoPdfUrl = anterior ?? ""; }
            _error = ex.Message;
        }
    }

    async Task Eliminar(Ponencia p)
    {
        try
        {
            await PonenciasSvc.DeleteAsync(p.Id, p.IdPonente);
            Pdfs.Delete(p.ArchivoPdfUrl);
            await CargarPonencias();
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
