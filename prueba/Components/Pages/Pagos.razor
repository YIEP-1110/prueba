@page "/pagos"
@attribute [StreamRendering]
@using prueba.Data
@using prueba.Services
@inject Microsoft.Extensions.Logging.ILogger<Pago> Logger

<PageTitle>Pagos</PageTitle>

<h3>Pagos</h3>

<EditForm Model="nuevoPago" OnValidSubmit="RegistrarPagoAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <label class="form-label" for="idParticipante">Id participante</label>
            <InputNumber id="idParticipante" class="form-control" @bind-Value="nuevoPago.IdParticipante" />
        </div>
        <div class="col-md-4">
            <label class="form-label" for="monto">Monto</label>
            <InputNumber id="monto" class="form-control" @bind-Value="nuevoPago.Monto" />
        </div>
        <div class="col-md-4">
            <label class="form-label" for="fechaPago">Fecha de pago</label>
            <InputDate id="fechaPago" class="form-control" @bind-Value="nuevoPago.FechaPago" />
        </div>
        <div class="col-md-6">
            <label class="form-label" for="metodoPago">Método de pago</label>
            <InputText id="metodoPago" class="form-control" @bind-Value="nuevoPago.MetodoPago" />
        </div>
        <div class="col-md-6">
            <label class="form-label" for="comprobante">Comprobante</label>
            <InputText id="comprobante" class="form-control" @bind-Value="nuevoPago.Comprobante" />
        </div>
        <div class="col-md-6 form-check ms-2">
            <InputCheckbox id="estado" class="form-check-input" @bind-Value="nuevoPago.Estado" />
            <label class="form-check-label" for="estado">Pago realizado</label>
        </div>
    </div>

    <button class="btn btn-primary mb-4" type="submit" disabled="@guardando">
        @(guardando ? "Guardando..." : "Registrar pago")
    </button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert alert-success">@mensaje</div>
}

@if (cargando)
{
    <p><em>Loading...</em></p>
}
else if (pagosError != null)
{
    <div class="alert alert-danger" role="alert">
        <strong>Database error:</strong> @pagosError
        <details>
            <summary>Show details</summary>
            <pre>@pagosErrorDetail</pre>
        </details>
    </div>
}
else if (!pagos.Any())
{
    <p><em>No se encontraron pagos.</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Id Participante</th>
                <th>Monto</th>
                <th>Metodo de Pago</th>
                <th>Fecha de Pago</th>
                <th>Estado de Pago</th>
                <th>Comprobante</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in pagos)
            {
                <tr>
                    <td>@p.IdPago</td>
                    <td>@p.IdParticipante</td>
                    <td>@p.Monto</td>
                    <td>@p.MetodoPago</td>
                    <td>@p.FechaPago.ToString("yyyy-MM-dd")</td>
                    <td>@(p.Estado ? "Pagado" : "Pendiente")</td>
                    <td>@p.Comprobante</td>
                </tr>
            }
        </tbody>
    </table>
}



@code {
    [Inject]
    private IPagosService PagosService { get; set; } = null!;

    private Pago[] pagos = Array.Empty<Pago>();
    private Pago nuevoPago = CrearPagoNuevo();
    private bool cargando = true;
    private bool guardando;
    private string? mensaje;
    private string? pagosError;
    private string? pagosErrorDetail;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            pagos = await PagosService.GetPagosAsync();
        }
        catch (Exception ex)
        {
            pagosError = ex.Message;
            pagosErrorDetail = ex.ToString();
            pagos = Array.Empty<Pago>();
            Logger.LogError(ex, "Error fetching pagos in component");
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task RegistrarPagoAsync()
    {
        guardando = true;
        pagosError = null;
        mensaje = null;

        try
        {
            await PagosService.RegistrarPagoAsync(nuevoPago);
            pagos = await PagosService.GetPagosAsync();
            nuevoPago = CrearPagoNuevo();
            mensaje = "El pago se registró correctamente.";
        }
        catch (Exception ex)
        {
            pagosError = "No se pudo registrar el pago.";
            pagosErrorDetail = ex.ToString();
            Logger.LogError(ex, "Error registering payment in Cosmos DB");
        }
        finally
        {
            guardando = false;
        }
    }

    private static Pago CrearPagoNuevo() => new()
    {
        FechaPago = DateOnly.FromDateTime(DateTime.Today)
    };
}
